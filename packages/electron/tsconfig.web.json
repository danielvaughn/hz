{
	"compilerOptions": {
		"target": "ES2023",
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"lib": ["ES2023", "DOM", "DOM.Iterable"],
		"types": ["svelte", "vite/client"],
		"strict": true,
		"noEmit": true,
		"isolatedModules": true,
		"verbatimModuleSyntax": true,
		"allowJs": true,
		"checkJs": true,
		"skipLibCheck": true
	},
	"include": ["src/renderer/**/*.d.ts", "src/renderer/**/*.ts", "src/renderer/**/*.svelte"]
}
